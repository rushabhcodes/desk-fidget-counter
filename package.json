{
  "name": "@tsci/rushabhcodes.desk-fidget-counter",
  "version": "5.11.0",
  "private": false,
  "description": "USB-powered scroll ring, persistent turn counter and laptop dashboard",
  "type": "module",
  "scripts": {
    "build": "tsci build index.circuit.tsx && tsci build assembly.circuit.tsx && bun scripts/stage-published-circuit.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bash scripts/test-firmware.sh",
    "check:netlist": "tsci check netlist index.circuit.tsx",
    "check:schematic": "tsci check schematic-placement index.circuit.tsx",
    "check:placement": "bun validation/check-placement.mjs",
    "check:shorts": "tsci check shorts dist/index/circuit.json",
    "dev": "tsci dev",
    "cad:pcb": "bun scripts/export-pcb-cad.mjs",
    "check:assembly": "bun validation/check-assembly.mjs",
    "export:jlcpcb": "python3 scripts/export-jlcpcb.py",
    "check:footprints": "bun validation/check-jlc-footprints.ts"
  },
  "dependencies": {
    "react": "19.2.0",
    "tscircuit": "0.0.3124"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "author": "rushabhcodes",
  "repository": {
    "type": "git",
    "url": "https://github.com/rushabhcodes/desk-fidget-counter.git"
  },
  "homepage": "https://tscircuit.com/rushabhcodes/desk-fidget-counter",
  "overrides": {
    "@tscircuit/circuit-json-util": "0.0.131"
  }
}
