{
  "mainEntrypoint": "assembly.circuit.tsx",
  "build": {
    "workerTimeoutMs": 1200000
  },
  "ignoredFiles": [
    "node_modules/**",
    "dist/autorouter-debug/**",
    "**/*.kicad_prl",
    "firmware/build/*.map",
    "**/__pycache__/**",
    "release/*.zip",
    "checks/**",
    "dist/*/kicad/**",
    "firmware/downloads/**",
    "routing/candidate.json",
    "mechanical/cad/*.glb",
    "manufacturing/current/**",
    "mechanical/vendor/step/**",
    "mechanical/vendor/solid/**"
  ]
}
